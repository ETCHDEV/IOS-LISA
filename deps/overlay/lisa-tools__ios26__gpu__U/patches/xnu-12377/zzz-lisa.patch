+/*
+ * Lisa: the console also goes to the phone's ramoops area, in the format of Linux's persistent_ram_buffer. The recovery's
+ * kernel gives all 2 MiB at 0xa9000000 to pmsg, so after a reset the log is the file /sys/fs/pstore/pmsg-ramoops-0.
+ * Through the bootstrap V=P mapping until fbcon_probe maps it.
+ */
+#define LISA_RING_PA            0xa9000000ul
+#define LISA_RING_SIZE          0x200000u
+#define LISA_RING_HEADER        12u
+#define LISA_RING_CAPACITY      (LISA_RING_SIZE - LISA_RING_HEADER)
+#define LISA_RING_SIG           0x43474244u     /* PERSISTENT_RAM_SIG */
+
+extern bool lisa_early_off;
+static volatile uint8_t *lisa_ring;
+static bool lisa_ring_cached, lisa_ring_resetting;
+static uint32_t lisa_ring_pos, lisa_ring_used, lisa_ring_match;
+
+void
+lisa_reset(void)
+{
+	register uint64_t x0 __asm__("x0");
+	register uint64_t x1 __asm__("x1");
+	register uint64_t x2 __asm__("x2");
+
+	__asm__ volatile ("dsb sy");
+	/* PSCI 1.1 SYSTEM_RESET2, warm: what keeps RAM. If firmware refuses it, SYSTEM_RESET. */
+	x0 = 0xc4000012ul;
+	x1 = 0;
+	x2 = 0;
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2) : : "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	x0 = 0x84000009ul;
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2) : : "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	for (;;) {
+		__asm__ volatile ("wfe");
+	}
+}
+
+/* Seconds by the architectural counter (19.2 MHz here), which needs nothing set up. */
+void
+lisa_reset_after(uint32_t seconds)
+{
+	uint64_t now, until;
+	extern void lisa_log_final(void);
+
+	lisa_log_final();
+	__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r" (now));
+	until = now + seconds * 19200000ull;
+	do {
+		__asm__ volatile ("isb; mrs %0, cntvct_el0" : "=r" (now));
+	} while (now < until);
+	lisa_reset();
+}
+
+static void
+lisa_ring_flush(volatile void *p, uint32_t bytes)
+{
+	if (!lisa_ring_cached) {
+		return;
+	}
+	for (uintptr_t a = (uintptr_t)p & ~63ul; a < (uintptr_t)p + bytes; a += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (a));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+static void
+lisa_ring_begin(volatile uint8_t *base, bool cached)
+{
+	volatile uint32_t *header = (volatile uint32_t *)base;
+
+	lisa_ring_cached = cached;
+	lisa_ring = base;
+	header[0] = LISA_RING_SIG;
+	header[1] = lisa_ring_pos;
+	header[2] = lisa_ring_used;
+	lisa_ring_flush(base, LISA_RING_HEADER);
+}
+
+void
+lisa_log_char(uint8_t c)
+{
+	static const char done[] = "Still waiting for root device";
+
+	if (lisa_ring == NULL) {
+		if (lisa_early_off) {
+			return;
+		}
+		lisa_ring_begin((volatile uint8_t *)LISA_RING_PA, true);
+	}
+	volatile uint32_t *header = (volatile uint32_t *)lisa_ring;
+	volatile uint8_t *at = lisa_ring + LISA_RING_HEADER + lisa_ring_pos;
+
+	{
+		extern void sweet_log_append(const char *c, int size);
+		sweet_log_append((const char *)&c, 1);
+	}
+	*at = c;
+	lisa_ring_flush(at, 1);
+	lisa_ring_pos = (lisa_ring_pos + 1) % LISA_RING_CAPACITY;
+	if (lisa_ring_used < LISA_RING_CAPACITY) {
+		lisa_ring_used++;
+	}
+	header[1] = lisa_ring_pos;
+	header[2] = lisa_ring_used;
+	lisa_ring_flush(header, LISA_RING_HEADER);
+
+	/* This far is a whole boot while the kernel has no root device: stop here, so the Mac gets the log. */
+	lisa_ring_match = (c == (uint8_t)done[lisa_ring_match]) ? lisa_ring_match + 1 : 0;
+	if (done[lisa_ring_match] == '\0' && !lisa_ring_resetting) {
+		lisa_ring_resetting = true;
+		lisa_reset_after(3);
+	}
+}
+
+/*
+ * Lisa: squares and text on the boot framebuffer before the console exists, through the bootstrap V=P mapping
+ * start.s adds for it. Usable until arm_vm_init takes TTBR0 away (lisa_early_off), then the console takes over.
+ */
+extern unsigned char iso_font[256 * 16];
+bool lisa_early_off;
+static uint32_t lisa_early_col, lisa_early_row;
+
+#define LISA_EARLY_FB           ((volatile uint32_t *)0xe1000000ul)
+#define LISA_EARLY_STRIDE       1080
+
+static void
+lisa_early_flush(volatile uint32_t *p, uint32_t pixels)
+{
+	for (uintptr_t a = (uintptr_t)p & ~63ul; a < (uintptr_t)(p + pixels); a += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (a));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+void
+lisa_early_mark(uint32_t n, uint32_t color)
+{
+	if (lisa_early_off) {
+		return;
+	}
+	for (uint32_t y = 0; y < 50; y++) {
+		volatile uint32_t *line = LISA_EARLY_FB + (1950 + y) * LISA_EARLY_STRIDE + 10 + n * 60;
+		for (uint32_t x = 0; x < 50; x++) {
+			line[x] = color;
+		}
+		lisa_early_flush(line, 50);
+	}
+}
+
+void
+lisa_early_text(const char *s)
+{
+	if (lisa_early_off) {
+		return;
+	}
+	for (; *s != '\0'; s++) {
+		lisa_log_char((uint8_t)*s);
+		if (*s == '\n' || lisa_early_col >= 66) {
+			lisa_early_col = 0;
+			lisa_early_row++;
+			if (*s == '\n') {
+				continue;
+			}
+		}
+		const unsigned char *glyph = iso_font + (unsigned char)*s * 16;
+		for (uint32_t gy = 0; gy < 32; gy++) {
+			volatile uint32_t *line = LISA_EARLY_FB + (620 + lisa_early_row * 34 + gy) * LISA_EARLY_STRIDE + 10 + lisa_early_col * 16;
+			for (uint32_t gx = 0; gx < 16; gx++) {
+				line[gx] = (glyph[gy / 2] & (1u << (gx / 2))) ? 0xffffffffu : 0xff400000u;
+			}
+			lisa_early_flush(line, 16);
+		}
+		lisa_early_col++;
+	}
+}
+
+void
+lisa_early_hex(const char *label, uint64_t value)
+{
+	char digits[20];
+	lisa_early_text(label);
+	for (int i = 0; i < 16; i++) {
+		unsigned d = (value >> (60 - i * 4)) & 15;
+		digits[i] = (char)(d < 10 ? '0' + d : 'a' + d - 10);
+	}
+	digits[16] = '\n';
+	digits[17] = '\0';
+	lisa_early_text(digits);
+}
+
+#if defined(XNU_ARM_DT_PLATFORM) && XNU_ARM_DT_PLATFORM
+/*
+ * Lisa: kprintf on the boot framebuffer, for a board with no usable UART. The port of the xnu-8796 Lisa
+ * kernel's console. The ADT node "sweet-fbcon" describes it: reg = <phys size>, width, height, stride.
+ * Lines wrap back to the top; the line after the cursor stays blank so the newest output is easy to find.
+ */
+#define FBCON_SCALE     2
+#define FBCON_FG        0xffffffffu
+#define FBCON_BG        0xff000000u
+
+static volatile uint32_t *fbcon_base;
+static uint32_t fbcon_width, fbcon_height, fbcon_stride;
+static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+static uint64_t fbcon_draw_until;
+
+static void
+fbcon_clear_row(uint32_t row)
+{
+	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
+		for (uint32_t x = 0; x < fbcon_width; x++) {
+			line[x] = FBCON_BG;
+		}
+	}
+}
+
+static void
+fbcon_newline(void)
+{
+	fbcon_col = 0;
+	fbcon_row = (fbcon_row + 1) % fbcon_rows;
+	fbcon_clear_row(fbcon_row);
+	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+}
+
+static void
+fbcon_transmit_data(uint8_t c)
+{
+	lisa_log_char(c);
+	if (fbcon_draw_until && mach_absolute_time() >= fbcon_draw_until) {
+		return;
+	}
+	if (c == '\r') {
+		fbcon_col = 0;
+		return;
+	}
+	if (c == '\n') {
+		fbcon_newline();
+		return;
+	}
+	if (fbcon_col >= fbcon_cols) {
+		fbcon_newline();
+	}
+	const unsigned char *glyph = iso_font + c * 16;
+	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
+			volatile uint32_t *line = fbcon_base + (y0 + gy * FBCON_SCALE + sy) * (fbcon_stride / 4) + x0;
+			for (uint32_t gx = 0; gx < 8; gx++) {
+				uint32_t px = (glyph[gy] & (1u << gx)) ? FBCON_FG : FBCON_BG;
+				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
+					line[gx * FBCON_SCALE + sx] = px;
+				}
+			}
+		}
+	}
+	fbcon_col++;
+}
+
+static void
+fbcon_init(void)
+{
+}
+
+static unsigned int
+fbcon_transmit_ready(void)
+{
+	return 1;
+}
+
+static unsigned int
+fbcon_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+fbcon_receive_data(void)
+{
+	return 0;
+}
+
+static struct pe_serial_functions fbcon_functions = {
+	.init = fbcon_init,
+	.transmit_ready = fbcon_transmit_ready,
+	.transmit_data = fbcon_transmit_data,
+	.receive_ready = fbcon_receive_ready,
+	.receive_data = fbcon_receive_data,
+};
+
+static bool
+fbcon_probe(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	uint32_t const *val;
+	unsigned int size;
+	uint32_t draw_secs = 15;
+	PE_parse_boot_argn("lisa_fbcon_secs", &draw_secs, sizeof(draw_secs));
+	fbcon_draw_until = mach_absolute_time() + (uint64_t)draw_secs * 19200000ULL;
+
+	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return false;
+	}
+	if (SecureDTGetProperty(entry, "width", (void const **)&val, &size) == kSuccess) {
+		fbcon_width = *val;
+	}
+	if (SecureDTGetProperty(entry, "height", (void const **)&val, &size) == kSuccess) {
+		fbcon_height = *val;
+	}
+	if (SecureDTGetProperty(entry, "stride", (void const **)&val, &size) == kSuccess) {
+		fbcon_stride = *val;
+	}
+	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
+		return false;
+	}
+	{
+		volatile uint8_t *ring = (volatile uint8_t *)ml_io_map_wcomb(LISA_RING_PA, LISA_RING_SIZE);
+		if (ring != NULL) {
+			lisa_ring_begin(ring, false);
+		}
+	}
+	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
+	if (fbcon_base == NULL) {
+		return false;
+	}
+	fbcon_cols = fbcon_width / (8 * FBCON_SCALE);
+	fbcon_rows = fbcon_height / (16 * FBCON_SCALE);
+	for (uint32_t r = 0; r < fbcon_rows; r++) {
+		fbcon_clear_row(r);
+	}
+	for (const char *s = "lisa: xnu-12377 fbcon up\n"; *s != '\0'; s++) {
+		fbcon_transmit_data((uint8_t)*s);
+	}
+	return true;
+}
