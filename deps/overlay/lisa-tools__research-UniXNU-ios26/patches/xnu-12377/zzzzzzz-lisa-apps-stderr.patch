+/* Lisa: what iOS processes write to stderr (OS_ACTIVITY_DT_MODE=1 sends their os_log there), filtered, in the console log.
+ * boot-arg lisa-stderr=1. Bounded: one line 300 bytes, 1.5 MiB a boot. */
+extern boolean_t PE_parse_boot_argn(const char *arg_string, void *arg_ptr, int max_arg);
+static void
+lisa_stderr_capture(struct proc *p, user_addr_t buffer, size_t length)
+{
+	static int enabled = -1;
+	static uint64_t total;
+	static const char * const keys[] = {"tatusBar", "ackgroundActivity", "ystemStatus", "rror", "ault", "oster",
+		"allpaper", "ecording", "mergency", "ensorActivity", "abort", "rash"};
+	char line[301];
+	bool wanted = false;
+
+	if (enabled < 0) {
+		int on = 0;
+		PE_parse_boot_argn("lisa-stderr", &on, sizeof(on));
+		enabled = on == 1;
+	}
+	if (enabled != 1 || length == 0 || total > 0x180000) {
+		return;
+	}
+	size_t n = MIN(length, sizeof(line) - 1);
+	if (copyin(buffer, line, n)) {
+		return;
+	}
+	line[n] = 0;
+	for (size_t k = 0; k < sizeof(keys) / sizeof(keys[0]); k++) {
+		wanted = wanted || strnstr(line, keys[k], n) != NULL;
+	}
+	static int lisa_first;
+	if (!wanted && lisa_first++ >= 30) {
+		return;
+	}
+	total += n;
+	printf("ios %s: %s\n", p->p_comm, line);
+}
+
 int
 write_nocancel(struct proc *p, struct write_nocancel_args *uap, user_ssize_t *retval)
 {
+	if (uap->fd == 2) {
+		lisa_stderr_capture(p, uap->cbuf, uap->nbyte);
+	}
 	return write_internal(p, uap->fd, uap->cbuf, uap->nbyte, (off_t)-1, 0,
 	           NULL, retval);
 }
