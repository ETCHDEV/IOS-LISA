+		if (!copyin(uap->iovp, lisa_iov, lisa_count * sizeof(lisa_iov[0]))) {
+			for (u_int lisa_i = 0; lisa_i < lisa_count; lisa_i++) {
+				lisa_stderr_capture(p, (user_addr_t)lisa_iov[lisa_i].iov_base, (size_t)lisa_iov[lisa_i].iov_len);
+			}
+		}
+	}
 	return writev_uio(p, uap->fd, uap->iovp, uap->iovcnt, 0, 0, NULL, retval);
