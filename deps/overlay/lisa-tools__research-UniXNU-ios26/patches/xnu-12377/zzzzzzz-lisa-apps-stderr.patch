+/* Lisa: the preinstalled apps stay in the OS volume's /private/var/staged_system_apps (no restore moved them). The Data
+ * mount covers that path, so before it they get a read-only union view over /Applications. boot-arg lisa-apps=1. */
+volatile int lisa_apps_stage = 0, lisa_apps_status = -1;
+static void
+lisa_apps_prepare(proc_t p, user_addr_t scratch)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("lisa-apps", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	static const char source[] = "/private/var/staged_system_apps", point[] = "/Applications";
+	native_gpu_addon_mount(p, scratch, 0x800, source, sizeof(source), point, sizeof(point),
+	    "/Applications/Preferences.app/Info.plist", "/Applications/Calculator.app/Info.plist",
+	    &lisa_apps_stage, &lisa_apps_status);
+	printf("LISA APPS: union over /Applications stage %d status %d\n", lisa_apps_stage, lisa_apps_status);
 }
 
