- * whole SMMU window and runs bringUp on a context that lives forever. */
+ * whole SMMU window and runs bringUp on a context that lives forever. sid may carry an
+ * iommus-style SMR mask in bits 16-30 (mask << 16 | id) when slot names a second slot in
+ * bits 8-15 (slot2 + 1) << 8: that slot routes id | mask, the stream of the other TBU (one
+ * mask bit only, as the Qualcomm Adreno SMMU's gfx_1 TBU adds 0x400 to every stream id). */
+#define NATIVE_ADRENO_ROUTE(slot,alias_slot) ((slot)|((alias_slot)+1u)<<8)
+#define NATIVE_ADRENO_STREAM(sid,mask) ((sid)|(mask)<<16)
+/* Splits an entry's (slot, sid) into its exact routes; 0 on a malformed pair. Inline: the GPU context uses it too, and
+ * the host simulation links that context without this one. */
+inline unsigned NativeAdrenoRoutes(unsigned slot,unsigned sid,ArmSmmu4KStream out[2])
+{
+    const unsigned primary=slot&0xff,alias=slot>>8,id=sid&0xffff,mask=sid>>16;
+    if(primary>127 || alias>128 || id>0x7fff || mask>0x7fff || !alias!=!mask)return 0;
+    out[0]={primary,uint16_t(id)};
+    if(!alias)return 1;
+    if((mask&(mask-1)) || (id&mask) || alias-1==primary || alias-1>127)return 0;
+    out[1]={alias-1,uint16_t(id|mask)};
+    return 2;
