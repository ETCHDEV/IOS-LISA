+
+// SAFETY: the frontend owns each counted array and its live handles through the
+// entire call. Clone the runtime functions before that storage can disappear.
+unsafe fn linked_array(pointer: *const *mut NmbFunction, count: usize) -> Result<Vec<LinkedFunction>, String> {
+    if count == 0 { return Ok(Vec::new()); }
+    if pointer.is_null() || count > isize::MAX as usize / std::mem::size_of::<*mut NmbFunction>() {
+        return Err("invalid linked function array".into());
+    }
+    unsafe { std::slice::from_raw_parts(pointer, count) }.iter()
+        .map(|&function| Ok(get(function)?.0.linked_function())).collect()
+}
+
+unsafe fn linked_functions(d: &NmbLinkedFunctions) -> Result<LinkedFunctions, String> {
+    let mut out = LinkedFunctions::new();
+    out.functions = unsafe { linked_array(d.functions, d.function_count)? };
+    out.private_functions = unsafe { linked_array(d.private_functions, d.private_count)? };
+    out.binary_functions = unsafe { linked_array(d.binary_functions, d.binary_count)? };
+    if d.group_count > 0 {
+        if d.groups.is_null() || d.group_count > isize::MAX as usize / std::mem::size_of::<NmbLinkedFunctionGroup>() {
+            return Err("invalid linked function groups".into());
+        }
+        for group in unsafe { std::slice::from_raw_parts(d.groups, d.group_count) } {
+            if group.name.is_null() { return Err("null linked function group name".into()); }
+            let name = unsafe { CStr::from_ptr(group.name) }.to_str().map_err(e("linked group name"))?;
+            if out.groups.contains_key(name) { return Err("duplicate linked function group name".into()); }
+            out.groups.insert(name.to_owned(), unsafe { linked_array(group.functions, group.count)? });
+        }
+    }
+    Ok(out)
+}
