+/*
+ * 2026-10-28: a second texture over the same memory with its own swizzle (Metal's
+ * -newTextureViewWithPixelFormat:...swizzle: and MTLTextureDescriptor.swizzle). The format is
+ * the source's: Metal allows a view in another format of the same size class, which needs a
+ * pipe format change this does not make yet (NULL then). Swizzle: MTLTextureSwizzle values,
+ * Zero 0, One 1, Red 2, Green 3, Blue 4, Alpha 5.
+ */
+struct rwa_texture *
+rwa_texture_view(struct rwa_texture *source, const unsigned char mtl_swizzle[4])
+{
+   if (!source)
+      return NULL;
+   struct rwa_texture *t = calloc(1, sizeof(*t));
+   if (!t)
+      return NULL;
+   *t = *source;
+   t->res = NULL;
+   pipe_resource_reference(&t->res, source->res);
+   t->view = NULL;
+   t->swizzled = false;
+   if (mtl_swizzle) {
+      static const unsigned char map[6] = { PIPE_SWIZZLE_0, PIPE_SWIZZLE_1, PIPE_SWIZZLE_X,
+                                            PIPE_SWIZZLE_Y, PIPE_SWIZZLE_Z, PIPE_SWIZZLE_W };
+      bool identity = true;
+      for (unsigned k = 0; k < 4; k++) {
+         t->swizzle[k] = mtl_swizzle[k] < 6 ? map[mtl_swizzle[k]] : PIPE_SWIZZLE_X + k;
+         identity = identity && t->swizzle[k] == PIPE_SWIZZLE_X + k;
+      }
+      t->swizzled = !identity;
+   }
+   return t;
+}
