+                 struct rwa_texture *destination, unsigned destination_level,
+                 unsigned destination_layer, const unsigned destination_origin[3],
+                 const unsigned size[3], char *why, size_t why_size)
+{
+   if (!device || !source || !destination || source->device != device ||
+       destination->device != device || !source_origin || !destination_origin || !size) {
+      say(why, why_size, "texture blit: missing texture/region or wrong device");
+      return -1;
+   }
+   enum pipe_format format = source->res->format;
+   if (format != destination->res->format || source->res->nr_samples > 1 ||
+       destination->res->nr_samples > 1 || format_is_depth_stencil(format) ||
+       util_format_get_blockwidth(format) != 1 || util_format_get_blockheight(format) != 1) {
+      say(why, why_size, "texture blit requires matching uncompressed single-sample colour formats");
+      return -1;
+   }
+   struct pipe_box src, dst;
+   if (!texture_box(source, source_level, source_layer, source_origin, size, &src, why, why_size) ||
+       !texture_box(destination, destination_level, destination_layer, destination_origin, size,
+                    &dst, why, why_size)) return -1;
+   if (source->res == destination->res && source_level == destination_level &&
+       src.x < dst.x + dst.width && dst.x < src.x + src.width &&
+       src.y < dst.y + dst.height && dst.y < src.y + src.height &&
+       src.z < dst.z + dst.depth && dst.z < src.z + src.depth) {
+      say(why, why_size, "overlapping texture blit regions");
+      return -1;
+   }
+   /* 2026-10-28: a GPU blit (see the framebuffer-fetch copy in render_draw_region for why not
+    * resource_copy_region on this port) */
+   {
+      struct pipe_blit_info bi;
+      memset(&bi, 0, sizeof(bi));
+      bi.dst.resource = destination->res; bi.dst.format = destination->res->format;
+      bi.dst.level = destination_level; bi.dst.box = dst;
+      bi.src.resource = source->res; bi.src.format = source->res->format;
+      bi.src.level = source_level; bi.src.box = src;
+      bi.mask = PIPE_MASK_RGBA; bi.filter = PIPE_TEX_FILTER_NEAREST;
+      device->pipe->blit(device->pipe, &bi);
+   }
