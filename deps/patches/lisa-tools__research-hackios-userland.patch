+static unsigned
+widen16_cb(const nir_instr *instr, UNUSED void *data)
+{
+   if (instr->type != nir_instr_type_alu)
+      return 0;
+   const nir_alu_instr *alu = nir_instr_as_alu(instr);
+   const nir_op_info *info = &nir_op_infos[alu->op];
+   if (info->is_conversion)
+      return 0;
+   bool half = alu->def.bit_size == 16 && nir_alu_type_get_base_type(info->output_type) == nir_type_float;
+   for (unsigned i = 0; i < info->num_inputs; i++)
+      if (nir_src_bit_size(alu->src[i].src) == 16 &&
+          nir_alu_type_get_base_type(info->input_types[i]) == nir_type_float)
+         half = true;
+   return half ? 32 : 0;
+}
+
+/*
+ * 2026-10-31: 32-BIT VARYINGS. The translator gives a `half4` varying a 16-bit variable in
+ * BOTH stages (every CoreAnimation colour: air.vertex_output of type half4). ir3's
+ * setup_output takes a 16-bit store_output's value as it is -- half registers, two of
+ * them per full register -- and nothing on a6xx (fd6_program's VPC set-up) looks at
+ * outputs[].half: the varying unit reads FULL registers. So each colour arrived as the
+ * bits of two packed halves plus whatever the next registers held: Settings' background
+ * red, its white cells cyan or lavender, a different picture from one compile to the next.
+ * Mesa's GL path never makes a 16-bit vertex output, which is why freedreno never cared.
+ * Here every 16-bit vertex-stage output is widened before it is stored, and every 16-bit
+ * fragment input is loaded at 32 bits and narrowed after, which is what ir3 knows.
+ * /private/var/tmp/lisa-nowideio turns it off (bisection).
+ */
+static nir_alu_type
+wide_io_type(nir_alu_type t)
+{
+   return (nir_alu_type)(nir_alu_type_get_base_type(t) | 32);
+}
+
+static bool
+wide_io_cb(nir_builder *b, nir_intrinsic_instr *intr, UNUSED void *data)
+{
+   if (b->shader->info.stage != MESA_SHADER_FRAGMENT &&
+       intr->intrinsic == nir_intrinsic_store_output) {
+      nir_def *v = intr->src[0].ssa;
+      if (v->bit_size != 16)
+         return false;
+      nir_alu_type t = nir_intrinsic_src_type(intr);
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def *w;
+      switch (nir_alu_type_get_base_type(t)) {
+      case nir_type_float: w = nir_f2f32(b, v); break;
+      case nir_type_int:   w = nir_i2i32(b, v); break;
+      default:             w = nir_u2u32(b, v); break;
+      }
+      nir_src_rewrite(&intr->src[0], w);
+      nir_intrinsic_set_src_type(intr, wide_io_type(t));
+      return true;
+   }
+   if (b->shader->info.stage == MESA_SHADER_FRAGMENT &&
+       (intr->intrinsic == nir_intrinsic_load_interpolated_input ||
+        intr->intrinsic == nir_intrinsic_load_input)) {
+      if (intr->def.bit_size != 16)
+         return false;
+      nir_alu_type t = nir_intrinsic_dest_type(intr);
+      intr->def.bit_size = 32;
+      nir_intrinsic_set_dest_type(intr, wide_io_type(t));
+      nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+      sem.medium_precision = 0;
+      nir_intrinsic_set_io_semantics(intr, sem);
+      b->cursor = nir_after_instr(&intr->instr);
+      nir_def *n;
+      switch (nir_alu_type_get_base_type(t)) {
+      case nir_type_float: n = nir_f2f16(b, &intr->def); break;
+      case nir_type_int:   n = nir_i2i16(b, &intr->def); break;
+      default:             n = nir_u2u16(b, &intr->def); break;
+      }
+      nir_def_rewrite_uses_after(&intr->def, n, n->parent_instr);
+      return true;
+   }
+   return false;
+}
