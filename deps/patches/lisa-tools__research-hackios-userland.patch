+static bool
+buffer_region(struct rwa_device *device, struct rwa_buffer *buffer, size_t offset,
+              size_t size, char *why, size_t why_size)
+{
+   if (!device || !buffer || buffer->device != device || offset > buffer->size ||
+       size > buffer->size - offset || offset > INT32_MAX || size > INT32_MAX - offset) {
+      say(why, why_size, "invalid buffer blit: wrong device, missing buffer, or out-of-range region");
+      return false;
+   }
+   return true;
+}
+
+int
+rwa_buffer_copy(struct rwa_device *device, struct rwa_buffer *source, size_t source_offset,
+                struct rwa_buffer *destination, size_t destination_offset, size_t size,
+                char *why, size_t why_size)
+{
+   if (!buffer_region(device, source, source_offset, size, why, why_size) ||
+       !buffer_region(device, destination, destination_offset, size, why, why_size)) return -1;
+   if (!size || (source == destination && source_offset == destination_offset)) return 0;
+   if (source->res == destination->res && source_offset < destination_offset + size &&
+       destination_offset < source_offset + size) {
+      say(why, why_size, "overlapping regions in a Metal buffer copy");
+      return -1;
+   }
+   struct pipe_box box = { .x = (int)source_offset, .width = (int)size, .height = 1, .depth = 1 };
+   device->pipe->resource_copy_region(device->pipe, destination->res, 0,
+       (unsigned)destination_offset, 0, 0, source->res, 0, &box);
+   return 0;
+}
+
+int
+rwa_buffer_fill(struct rwa_device *device, struct rwa_buffer *buffer, size_t offset,
+                size_t size, uint8_t value, char *why, size_t why_size)
+{
+   if (!buffer_region(device, buffer, offset, size, why, why_size)) return -1;
+   if (!size) return 0;
+   device->pipe->clear_buffer(device->pipe, buffer->res, (unsigned)offset,
+                              (unsigned)size, &value, 1);
+   return 0;
+}
