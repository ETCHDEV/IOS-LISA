+/// Lisa: `vulkan`, saying which line of prime.rs it was
+pub(crate) fn vulkan_at(result: ash::vk::Result, line: u32) -> Error {
+    lisa_trace(&format!("prime.rs line {line}: {result:?}"));
+    vulkan(result)
