+fn lisa_trace(what: &str) {
+    use std::io::Write;
+    let trace = std::backtrace::Backtrace::force_capture();
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open("/private/var/tmp/lisa-m2v-trace.log") {
