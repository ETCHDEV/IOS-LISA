 }
+
+/* Low-volume opt-in boot status. Counts processes, not their health. */
+extern uint64_t lisa_fb_swap_count(void);
+void lisa_status_start(void);
+struct lisa_status_counts { unsigned springboard, backboard, migration; };
+static int
+lisa_status_proc(proc_t p, void *arg)
+{
+    struct lisa_status_counts *c = arg;
+    char name[32];
+    proc_name(proc_pid(p), name, sizeof(name));
+    if (strcmp(name, "SpringBoard") == 0) c->springboard++;
+    if (strcmp(name, "backboardd") == 0) c->backboard++;
+    if (strcmp(name, "datamigrator") == 0) c->migration++;
+    return PROC_RETURNED;
+}
+static void
+lisa_status_thread(__unused void *arg, __unused wait_result_t wr)
+{
+    static int chan;
+    for (unsigned i = 0; i < 40; i++) {
+        (void)tsleep(&chan, PZERO, "lisastat", 30 * hz);
+        struct lisa_status_counts c = {0};
+        proc_iterate(PROC_ALLPROCLIST, lisa_status_proc, &c, NULL, NULL);
+        printf("LISA STATUS: SpringBoard %u backboardd %u migration %u swaps %llu\n",
+            c.springboard, c.backboard, c.migration, lisa_fb_swap_count());
+    }
+}
+void
+lisa_status_start(void)
+{
+    thread_t thread;
+    if (kernel_thread_start(lisa_status_thread, NULL, &thread) == KERN_SUCCESS) {
+        thread_deallocate(thread);
+    }
+}
