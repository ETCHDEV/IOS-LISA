+/* libamfi calls the policy named "AMFI", not the human-readable policy
+ * description. Without this ABI dyld disables @rpath expansion and inserted
+ * libraries, even for our validated system apps with embedded frameworks.
+ * Match HackiOS kern_minimac.c's experimental-port policy. Signature/page
+ * validation above remains unchanged. */
+static int
+sweet_amfi_policy_syscall(__unused struct proc *p, int call, user_addr_t arg)
+{
+	struct {
+		uint64_t input_flags;
+		user_addr_t output_flags;
+	} args;
+	uint64_t value;
+	int error;
+
+	if (call == 0x60) { /* ExtensionKit: this port has no AMFI verification service. */
+		value = 0x86;
+		return copyout(&value, arg, sizeof(value));
+	}
+	if (call != 0x5a) {
+		return ENOPOLICY;
+	}
+	error = copyin(arg, &args, sizeof(args));
+	if (error != 0) {
+		return error;
+	}
+	value = 0xff; /* dyld @paths, environment, interposition in this research OS */
+	return copyout(&value, args.output_flags, sizeof(value));
+}
+
 static const struct mac_policy_ops sweet_amfi_mac_ops = {
 	.mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
+	.mpo_policy_syscall = sweet_amfi_policy_syscall,
 };
 
